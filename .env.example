# Project Configuration
# Root path of the SS14 project
PROJECT_ROOT=g:\Development\ss14\Andromeda-v

# Source and Target Locales
# Locale codes for source (base) and target (destination) translations
SOURCE_LOCALE=en-US
TARGET_LOCALE=pt-BR

# Argos Translate Language Codes
# Used by Argos Translate to identify the translation direction
# Download models from: https://www.argosopentech.com/argospm/index/
SOURCE_ARGOS_CODE=en
TARGET_ARGOS_CODE=pb

# Locale Directories
# Paths to the source and target .ftl (Fluent) translation files
SOURCE_LOCALE_DIR=g:\Development\ss14\Andromeda-v\Resources\Locale\en-US
TARGET_LOCALE_DIR=g:\Development\ss14\Andromeda-v\Resources\Locale\pt-BR

# Argos Model Configuration
# Path to the .argosmodel file for the language pair
ARGOS_MODEL_PATH=./translate-en_pb-1_9.argosmodel

# Automatically install the Argos model if not found (true/false)
AUTO_INSTALL_MODEL=true

# Internal Argos data/cache directory
ARGOS_DATA_DIR=./.argos

# Translation Behavior
# Overwrite existing translation keys in target locale (true/false)
OVERWRITE_EXISTING_KEYS=false

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Show per-file progress logs (true/false)
LOG_FILE_PROGRESS=true

# Show progress bar with tqdm (true/false)
SHOW_PROGRESS_BAR=true

# Output Log File
# Path to save unchanged translations (identical to source)
UNCHANGED_LOG_PATH=./unchanged_translations.txt

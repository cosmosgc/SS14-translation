# LLM API (OpenAI-compatible endpoint)
LLM_API_BASE=http://127.0.0.1:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=300

# Languages (override root .env locale settings if needed)
SOURCE_LANG=en
TARGET_LANG=pt-BR

# Cache directory (relative to this file)
CACHE_DIR=./.cache
